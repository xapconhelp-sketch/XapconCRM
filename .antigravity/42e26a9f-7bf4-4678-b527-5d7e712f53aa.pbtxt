    replacement_chunks {
      target_content: "  // Action: Copilot Chat submit to full-stack backend\n  const handleSendCopilotMessage = async (userMsg: string) => {\n    // Append user message immediately\n    const userMessageObj: ChatMessage = {\n      sender: \"user\",\n      text: userMsg,\n      timestamp: new Date().toLocaleTimeString().substring(0, 5)\n    };\n    setChatHistory((prev) => [...prev, userMessageObj]);\n    setIsLoadingCopilot(true);\n\n    // Build context description based on current active tabs and data\n    let contextStr = `Vista actual: ${currentView.toUpperCase()}.\\n`;\n    if (currentView === ViewType.CLAIMS) {\n      contextStr += `El usuario est\303\241 revisando el presupuesto ${estimate.id} para ${estimate.clientName}.\\n`;\n      contextStr += `Monto Total: $${estimate.total.toLocaleString(\"en-US\", { minimumFractionDigits: 2 })}, Margen de Beneficio: ${estimate.profitMargin}%.\\n`;\n      contextStr += `Conceptos: ${estimate.items.map((i) => `${i.description} (Qty: ${i.qty}, Price: $${i.unitPrice})`).join(\", \")}.\\n`;\n    } else if (currentView === ViewType.LEADS) {\n      contextStr += `El usuario est\303\241 en el expediente del cliente ${activeLead.name} (${activeLead.id}).\\n`;\n      contextStr += `Direcci\303\263n: ${activeLead.address}, Seguro: ${activeLead.insuranceProvider}, Reclamo #: ${activeLead.claimNumber}.\\n`;\n      contextStr += `Estado del cliente: ${activeLead.status}.\\n`;\n    } else {\n      contextStr += `El usuario est\303\241 explorando el CRM de Apex Roofing.\\n`;\n    }\n\n    try {\n      const response = await fetch(\"/api/copilot\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          message: userMsg,\n          history: chatHistory.concat(userMessageObj),\n          context: contextStr\n        })\n      });\n      const data = await response.json();\n      \n      setChatHistory((prev) => [\n        ...prev,\n        {\n          sender: \"copilot\",\n          text: data.text,\n          timestamp: new Date().toLocaleTimeString().substring(0, 5)\n        }\n      ]);\n    } catch (err: any) {\n      console.error(\"Error communicating with AI Copilot backend:\", err);\n      setChatHistory((prev) => [\n        ...prev,\n        {\n          sender: \"copilot\",\n          text: \"Lo siento, ha ocurrido un error al conectar con el servidor del Copiloto de IA. Por favor, verifica que tu servidor Express est\303\251 encendido y que tengas tu API key configurada.\",\n          timestamp: new Date().toLocaleTimeString().substring(0, 5)\n        }\n      ]);\n    } finally {\n      setIsLoadingCopilot(false);\n    }\n  };\n\n  const handleSuggestionClick = (actionName: string) => {\n    if (actionName === \"Solicitar Reporte EagleView\") {\n      handleAddTimelineEvent(activeLead.id, {\n        type: \"system\",\n        author: \"AI Copilot\",\n        title: \"Reporte Solicitado\",\n        content: \"Se ha enviado una solicitud automatizada de reporte de medidas a EagleView para la propiedad del cliente.\"\n      });\n      setChatHistory((prev) => [\n        ...prev,\n        {\n          sender: \"copilot\",\n          text: `He solicitado oficialmente el reporte de medidas estructurales a **EagleView** para la direcci\303\263n de ${activeLead.name}. Ver\303\241s el evento registrado en la L\303\255nea de Tiempo del cliente.`,\n          timestamp: new Date().toLocaleTimeString().substring(0, 5)\n        }\n      ]);\n    } else if (actionName === \"Agendar Inspecci\303\263n F\303\255sica\") {\n      const newInsp: InspectionAppointment = {\n        id: `insp-auto-${Date.now()}`,\n        dateTime: \"Ma\303\261ana, 11:00 AM\",\n        clientName: activeLead.name,\n        address: activeLead.address,\n        type: \"Inspecci\303\263n Perito\",\n        inspectorName: \"Elena Rostova\",\n        inspectorInitials: \"ER\"\n      };\n      setInspections((prev) => [newInsp, ...prev]);\n      handleAddTimelineEvent(activeLead.id, {\n        type: \"call_log\",\n        author: \"AI Copilot\",\n        title: \"Inspecci\303\263n Perito Agendada\",\n        content: \"Se agend\303\263 inspecci\303\263n t\303\251cnica presencial en la propiedad de James Robertson para ma\303\261ana a las 11:00 AM con Elena Rostova.\"\n      });\n      setChatHistory((prev) => [\n        ...prev,\n        {\n          sender: \"copilot\",\n          text: `He agendado la inspecci\303\263n t\303\251cnica presencial para **ma\303\261ana a las 11:00 AM** con la Project Manager **Elena Rostova**. Ver\303\241s la cita a\303\261adida en el calendario del Dashboard general.`,\n          timestamp: new Date().toLocaleTimeString().substring(0, 5)\n        }\n      ]);\n    } else if (actionName === \"Enviar Recordatorio al Cliente\") {\n      handleAddTimelineEvent(activeLead.id, {\n        type: \"call_log\",\n        author: \"Michael Chen\",\n        title: \"SMS Recordatorio Enviado\",\n        content: \"Recordatorio enviado por SMS: \'Hola James, te recordamos que tu reclamo al seguro debe ingresarse pronto. Por favor ll\303\241manos.\'\"\n      });\n      setChatHistory((prev) => [\n        ...prev,\n        {\n          sender: \"copilot\",\n          text: `He disparado un SMS formal de recordatorio a **${activeLead.name}** record\303\241ndole adjuntar su n\303\272mero de p\303\263liza final. Bit\303\241cora actualizada en el expediente.`,\n          timestamp: new Date().toLocaleTimeString().substring(0, 5)\n        }\n      ]);\n    } else {\n      handleSendCopilotMessage(`Solicito ejecutar acci\303\263n: ${actionName}`);\n    }\n  };\n\n  // Quick action CTA sidebar \"Nuevo Proyecto\"\n  const handleNewEstimateCTA = () => {\n    setCurrentView(ViewType.CLAIMS);\n    setEstimate({\n      ...initialEstimate,\n      status: \"Draft\",\n      profitMargin: 24.5\n    });\n  };\n\n  // Built dynamic contextual suggestions for right side panels\n  const contextualReview = currentView === ViewType.CLAIMS \n    ? {\n        summary: `Presupuesto EST-2409-A para James Robertson. Subtotal Bruto: $${estimate.subtotalGross.toLocaleString(\"en-US\", { minimumFractionDigits: 2 })} USD. El margen actual es del ${estimate.profitMargin}%.`,\n        riskLevel: estimate.profitMargin < 30 ? \"Alto\" as const : \"Bajo\" as const,\n        riskScore: estimate.profitMargin < 30 ? 78 : 12,\n        riskDescription: estimate.profitMargin < 30 \n          ? \"El margen proyectado es inferior al umbral corporativo de seguridad del 30%. Reclamo requiere ajuste de tarifas.\"\n          : \"El margen de beneficio cumple perfectamente con los par\303\241metros de utilidad est\303\241ndar del 30%.\",\n        proactiveAlerts: estimate.profitMargin < 30 \n          ? [\"Advertencia: Mano de obra tasada por debajo del promedio est\303\241ndar.\", \"Validaci\303\263n requerida para teja asf\303\241ltica Owens Corning.\"] \n          : [],\n        suggestions: estimate.profitMargin < 30 \n          ? [\"Optimizar precio mano de obra al 30%\"] \n          : [\"Aprobar Presupuesto y Enviar\"]\n      }\n    : activeLead.aiCopilotReview;"
