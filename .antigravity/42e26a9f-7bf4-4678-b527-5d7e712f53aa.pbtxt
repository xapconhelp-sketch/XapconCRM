  file_change {
    absolute_path_uri: "file:///src/components/AICopilotPanel.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef, useEffect } from \"react\";\nimport { AICopilotReview, ChatMessage } from \"../types\";\nimport { \n  Bot, \n  MessageSquare, \n  FileText, \n  Send, \n  AlertTriangle, \n  ShieldAlert, \n  TrendingUp, \n  CheckSquare, \n  ArrowRight,\n  Info,\n  Loader2\n} from \"lucide-react\";\n\ninterface AICopilotPanelProps {\n  review?: AICopilotReview;\n  contextDescription: string;\n  chatHistory: ChatMessage[];\n  onSendMessage: (msg: string) => void;\n  isLoading: boolean;\n  onSuggestionClick?: (action: string) => void;\n}\n\nexport default function AICopilotPanel({\n  review,\n  contextDescription,\n  chatHistory,\n  onSendMessage,\n  isLoading,\n  onSuggestionClick\n}: AICopilotPanelProps) {\n  const [activeTab, setActiveTab] = useState<\"review\" | \"chat\">(\"review\");\n  const [inputText, setInputText] = useState(\"\");\n  const chatBottomRef = useRef<HTMLDivElement>(null);\n\n  useEffect(() => {\n    if (chatBottomRef.current) {\n      chatBottomRef.current.scrollIntoView({ behavior: \"smooth\" });\n    }\n  }, [chatHistory, activeTab]);\n\n  const handleSend = () => {\n    if (!inputText.trim() || isLoading) return;\n    onSendMessage(inputText.trim());\n    setInputText(\"\");\n    setActiveTab(\"chat\"); // Auto switch to chat on query\n  };\n\n  const handleKeyPress = (e: React.KeyboardEvent) => {\n    if (e.key === \"Enter\") {\n      handleSend();\n    }\n  };\n\n  const handleActionClick = (suggestion: string) => {\n    if (onSuggestionClick) {\n      onSuggestionClick(suggestion);\n    } else {\n      onSendMessage(`Sugerencia ejecutada: ${suggestion}`);\n    }\n    setActiveTab(\"chat\");\n  };\n\n  return (\n    <aside className=\"w-full xl:w-[320px] h-full bg-[#f2f4f6] dark:bg-[#eceef0] border-l border-[#c6c6cd] shadow-lg flex flex-col pt-4 pb-2 px-4 z-40 shrink-0 select-none\">\n      {/* AI Copilot Header */}\n      <div className=\"flex items-center gap-3 mb-4\">\n        <div className=\"w-10 h-10 rounded-lg bg-teal-50 flex items-center justify-center text-[#006c49] shadow-sm\">\n          <Bot className=\"w-6 h-6 animate-pulse\" />\n        </div>\n        <div>\n          <h2 className=\"font-sans text-md font-bold text-[#131b2e] tracking-tight\">AI Copilot</h2>\n          <p className=\"font-mono text-[10px] text-[#7c839b] font-medium tracking-wide uppercase\">Contextual Intelligence</p>\n        </div>\n      </div>\n\n      {/* Tabs */}\n      <div className=\"flex border-b border-[#c6c6cd]/50 pb-2 mb-4 gap-2\">\n        <button\n          onClick={() => setActiveTab(\"review\")}\n          className={`flex-1 font-sans text-xs font-semibold py-1.5 px-3 rounded-md transition-all ${\n            activeTab === \"review\"\n              ? \"bg-[#6cf8bb] text-[#002113] shadow-sm font-bold\"\n              : \"text-[#45464d] hover:bg-[#e0e3e5]/50\"\n          }`}\n        >\n          An\303\241lisis\n        </button>\n        <button\n          onClick={() => setActiveTab(\"chat\")}\n          className={`flex-1 font-sans text-xs font-semibold py-1.5 px-3 rounded-md transition-all flex items-center justify-center gap-1.5 ${\n            activeTab === \"chat\"\n              ? \"bg-[#6cf8bb] text-[#002113] shadow-sm font-bold\"\n              : \"text-[#45464d] hover:bg-[#e0e3e5]/50\"\n          }`}\n        >\n          <span>Copilot Chat</span>\n          {chatHistory.length > 0 && (\n            <span className=\"w-2 h-2 rounded-full bg-red-500\"></span>\n          )}\n        </button>\n      </div>\n\n      {/* Tab Panels */}\n      <div className=\"flex-1 overflow-y-auto space-y-4 pr-1\">\n        {activeTab === \"review\" ? (\n          <>\n            {/* Smart Summary */}\n            {review?.summary && (\n              <div className=\"bg-white border border-[#c6c6cd]/40 rounded-xl p-4 shadow-sm hover:shadow-md transition-all duration-200\">\n                <div className=\"flex items-center gap-2 mb-2 text-[#006c49] font-bold border-b border-[#eceef0] pb-1.5 text-xs\">\n                  <FileText className=\"w-4 h-4\" />\n                  <span>Resumen Inteligente</span>\n                </div>\n                <p className=\"font-sans text-xs text-[#45464d] leading-relaxed\">\n                  {review.summary}\n                </p>\n              </div>\n            )}\n\n            {/* Risk Scan */}\n            {review?.riskLevel && (\n              <div className=\"bg-white border border-[#c6c6cd]/40 rounded-xl p-4 shadow-sm hover:shadow-md transition-all duration-200\">\n                <div className=\"flex items-center justify-between mb-2 border-b border-[#eceef0] pb-1.5\">\n                  <div className=\"flex items-center gap-2 text-xs font-bold text-[#45464d]\">\n                    <ShieldAlert className=\"w-4 h-4 text-amber-500\" />\n                    <span>An\303\241lisis de Riesgo</span>\n                  </div>\n                  <span className={`px-2 py-0.5 rounded-full text-[9px] uppercase font-bold ${\n                    review.riskLevel === \"Alto\" \n                      ? \"bg-red-50 text-red-700 border border-red-200\" \n                      : review.riskLevel === \"Medio\"\n                      ? \"bg-amber-50 text-amber-700 border border-amber-200\"\n                      : \"bg-emerald-50 text-emerald-700 border border-emerald-200\"\n                  }`}>\n                    Riesgo {review.riskLevel}\n                  </span>\n                </div>\n                <div className=\"w-full bg-[#eceef0] rounded-full h-1.5 mb-2 overflow-hidden\">\n                  <div \n                    className={`h-full rounded-full transition-all duration-500 ${\n                      review.riskLevel === \"Alto\" ? \"bg-red-500\" : review.riskLevel === \"Medio\" ? \"bg-amber-500\" : \"bg-emerald-500\"\n                    }`}\n                    style={{ width: `${review.riskScore}%` }}\n                  ></div>\n                </div>\n                <p className=\"font-sans text-xs text-[#7c839b] leading-tight\">\n                  {review.riskDescription}\n                </p>\n              </div>\n            )}\n\n            {/* Proactive Alerts */}\n            {review?.proactiveAlerts && review.proactiveAlerts.length > 0 && (\n              <div className=\"bg-white border-l-4 border-l-red-500 border-y border-r border-[#c6c6cd]/40 rounded-xl p-4 shadow-sm hover:shadow-md transition-all duration-200\">\n                <div className=\"flex items-center gap-2 mb-2 text-[#191c1e] border-b border-[#eceef0] pb-1.5 text-xs font-bold\">\n                  <AlertTriangle className=\"w-4 h-4 text-red-500\" />\n                  <span>Alertas Proactivas</span>\n                </div>\n                <ul className=\"space-y-2\">\n                  {review.proactiveAlerts.map((alert, idx) => (\n                    <li key={idx} className=\"flex items-start gap-1.5 text-xs\">\n                      <span className=\"w-1.5 h-1.5 rounded-full bg-red-500 mt-1.5 shrink-0\"></span>\n                      <span className=\"text-[#45464d]\">{alert}</span>\n                    </li>\n                  ))}\n                </ul>\n              </div>\n            )}\n\n            {/* Suggestions */}\n            {review?.suggestions && review.suggestions.length > 0 && (\n              <div className=\"bg-white border border-[#c6c6cd]/40 rounded-xl p-4 shadow-sm hover:shadow-md transition-all duration-200\">\n                <div className=\"flex items-center gap-2 mb-2 text-[#45464d] border-b border-[#eceef0] pb-1.5 text-xs font-bold\">\n                  <CheckSquare className=\"w-4 h-4\" />\n                  <span>Sugerencias de Acci\303\263n</span>\n                </div>\n                <div className=\"space-y-2\">\n                  {review.suggestions.map((s, idx) => (\n                    <button\n                      key={idx}\n                      onClick={() => handleActionClick(s)}\n                      className=\"w-full text-left px-3 py-2 bg-[#f2f4f6] hover:bg-[#eceef0] border border-[#c6c6cd]/30 rounded-lg text-xs text-[#191c1e] flex items-center justify-between transition-colors font-medium active:scale-[0.99]\"\n                    >\n                      <span>{s}</span>\n                      <ArrowRight className=\"w-3.5 h-3.5 text-[#006c49]\" />\n                    </button>\n                  ))}\n                </div>\n              </div>\n            )}\n\n            {/* Baseline instructions info */}\n            <div className=\"bg-[#f7f9fb]/50 border border-[#c6c6cd]/30 rounded-lg p-3 text-[11px] text-[#7c839b] flex gap-2\">\n              <Info className=\"w-4 h-4 shrink-0 text-[#7c839b]\" />\n              <span>An\303\241lisis de IA contextualizado para techado de alta precisi\303\263n.</span>\n            </div>\n          </>\n        ) : (\n          /* Chat Tab */\n          <div className=\"flex flex-col h-full space-y-4\">\n            {/* Scrollable messages area */}\n            <div className=\"flex-1 bg-white border border-[#c6c6cd]/30 rounded-xl p-3 h-[300px] overflow-y-auto space-y-3 shadow-inner\">\n              {chatHistory.length === 0 ? (\n                <div className=\"h-full flex flex-col items-center justify-center text-center p-4\">\n                  <Bot className=\"w-10 h-10 text-[#7c839b]/60 mb-2 animate-bounce\" />\n                  <p className=\"font-sans text-xs text-[#7c839b] font-medium leading-relaxed\">\n                    \302\241Preg\303\272ntame sobre este cliente, el estimado de materiales o la cobertura del seguro!\n                  </p>\n                </div>\n              ) : (\n                chatHistory.map((msg, index) => (\n                  <div\n                    key={index}\n                    className={`flex flex-col max-w-[85%] ${\n                      msg.sender === \"user\" ? \"ml-auto items-end\" : \"mr-auto items-start\"\n                    }`}\n                  >\n                    <span className=\"text-[10px] text-[#7c839b] mb-0.5 px-1 font-mono uppercase\">\n                      {msg.sender === \"user\" ? \"T\303\272\" : \"Copiloto\"}\n                    </span>\n                    <div\n                      className={`p-2.5 rounded-2xl text-xs shadow-sm leading-relaxed ${\n                        msg.sender === \"user\"\n                          ? \"bg-[#131b2e] text-white rounded-tr-none\"\n                          : \"bg-[#eceef0] text-[#191c1e] rounded-tl-none border border-[#c6c6cd]/20\"\n                      }`}\n                    >\n                      <p className=\"whitespace-pre-wrap\">{msg.text}</p>\n                    </div>\n                  </div>\n                ))\n              )}\n              {isLoading && (\n                <div className=\"flex items-center gap-2 mr-auto bg-[#eceef0] text-[#7c839b] p-3 rounded-2xl rounded-tl-none border border-[#c6c6cd]/20 max-w-[85%] text-xs shadow-sm\">\n                  <Loader2 className=\"w-3.5 h-3.5 animate-spin text-[#006c49]\" />\n                  <span>Pensando...</span>\n                </div>\n              )}\n              <div ref={chatBottomRef} />\n            </div>\n\n            {/* Preset prompt helper bubbles */}\n            <div className=\"flex flex-wrap gap-1.5 shrink-0 select-none\">\n              <button\n                onClick={() => {\n                  setInputText(\"\302\277C\303\263mo puedo optimizar el margen del estimado?\");\n                }}\n                className=\"text-[10px] font-sans bg-[#eceef0] hover:bg-[#e0e3e5] px-2 py-1 rounded-full text-[#45464d] border border-[#c6c6cd]/20 transition-all active:scale-95\"\n              >\n                \302\277Optimizar margen?\n              </button>\n              <button\n                onClick={() => {\n                  setInputText(\"Redacta un correo formal para el ajustador David Chen de State Farm.\");\n                }}\n                className=\"text-[10px] font-sans bg-[#eceef0] hover:bg-[#e0e3e5] px-2 py-1 rounded-full text-[#45464d] border border-[#c6c6cd]/20 transition-all active:scale-95\"\n              >\n                Escribir correo a ajustador\n              </button>\n              <button\n                onClick={() => {\n                  setInputText(\"Explica los pasos recomendados para la aprobaci\303\263n del reclamo.\");\n                }}\n                className=\"text-[10px] font-sans bg-[#eceef0] hover:bg-[#e0e3e5] px-2 py-1 rounded-full text-[#45464d] border border-[#c6c6cd]/20 transition-all active:scale-95\"\n              >\n                \302\277Pasos de aprobaci\303\263n?\n              </button>\n            </div>\n          </div>\n        )}\n      </div>\n\n      {/* Input box bottom */}\n      <div className=\"mt-auto py-2 shrink-0\">\n        <div className=\"relative\">\n          <input\n            type=\"text\"\n            value={inputText}\n            onChange={(e) => setInputText(e.target.value)}\n            onKeyDown={handleKeyPress}\n            placeholder=\"Preguntar al Copiloto...\"\n            disabled={isLoading}\n            className=\"w-full bg-white border border-[#c6c6cd] rounded-full py-2.5 pl-4 pr-10 font-sans text-xs focus:ring-2 focus:ring-[#006c49] focus:border-[#006c49] outline-none text-[#191c1e] transition-all disabled:bg-[#f2f4f6]\"\n          />\n          <button\n            onClick={handleSend}\n            disabled={isLoading || !inputText.trim()}\n            className=\"absolute right-1.5 top-1/2 -translate-y-1/2 text-[#006c49] hover:bg-[#6cf8bb]/40 p-2 rounded-full transition-colors disabled:opacity-50 disabled:hover:bg-transparent\"\n          >\n            <Send className=\"w-3.5 h-3.5\" />\n          </button>\n        </div>\n      </div>\n    </aside>\n  );\n}\n"
