    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \"react\";\nimport { ViewType } from \"../types\";\nimport { \n  LayoutDashboard, \n  Users, \n  FileSignature, \n  HardHat, \n  DollarSign, \n  Users2, \n  Settings, \n  HelpCircle,\n  Plus,\n  Roofing // wait, let\'s use a standard Home, Shield or custom Roofing from lucide-react if available. Wait, Lucide has \'Home\' or \'Layers\' or custom SVG/Lucide \'Wrench\'. Let\'s use \'Wrench\' or \'Hammer\' or \'Home\' or \'ShieldAlert\'.\n} from \"lucide-react\";\n\ninterface SidebarProps {\n  currentView: ViewType;\n  onViewChange: (view: ViewType) => void;\n  onNewEstimate: () => void;\n}\n\nexport default function Sidebar({ currentView, onViewChange, onNewEstimate }: SidebarProps) {\n  const menuItems = [\n    { type: ViewType.DASHBOARD, label: \"Dashboard\", icon: LayoutDashboard },\n    { type: ViewType.LEADS, label: \"Leads\", icon: Users },\n    { type: ViewType.CLAIMS, label: \"Claims\", icon: FileSignature },\n    { type: ViewType.PRODUCTION, label: \"Production\", icon: HardHat },\n    { type: ViewType.FINANCIALS, label: \"Financials\", icon: DollarSign },\n    { type: ViewType.TEAM, label: \"Team\", icon: Users2 },\n  ];\n\n  return (\n    <nav className=\"hidden md:flex flex-col h-screen w-[280px] bg-[#131b2e] text-white p-4 fixed left-0 top-0 z-50 shrink-0 select-none\">\n      {/* Brand Header */}\n      <div className=\"mb-8 px-2 py-3 flex items-center gap-3\">\n        <div className=\"w-10 h-10 rounded bg-[#6ffbbe] flex items-center justify-center text-[#002113] shrink-0 font-bold text-lg\">\n          \342\226\262\n        </div>\n        <div>\n          <h1 className=\"font-sans text-[20px] font-bold leading-tight tracking-tight text-white\">Apex Roofing</h1>\n          <p className=\"font-sans text-xs text-[#7c839b] font-medium mt-0.5\">Enterprise Management</p>\n        </div>\n      </div>\n\n      {/* Primary CTA */}\n      <button \n        onClick={onNewEstimate}\n        className=\"w-full bg-[#006c49] text-white py-3 px-4 rounded-lg font-semibold hover:bg-[#005236] active:scale-[0.98] transition-all flex items-center justify-center gap-2 shadow-sm mb-8\"\n      >\n        <Plus className=\"w-5 h-5\" />\n        Nuevo Proyecto\n      </button>\n\n      {/* Navigation Links */}\n      <div className=\"flex-1 space-y-1 overflow-y-auto pr-1\">\n        {menuItems.map((item) => {\n          const Icon = item.icon;\n          const isActive = currentView === item.type;\n          return (\n            <button\n              key={item.type}\n              onClick={() => onViewChange(item.type)}\n              className={`w-full flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium transition-all duration-150 ${\n                isActive \n                  ? \"bg-[#6cf8bb] text-[#002113] font-bold shadow-sm\" \n                  : \"text-[#7c839b] hover:text-white hover:bg-white/5\"\n              }`}\n            >\n              <Icon className={`w-5 h-5 ${isActive ? \"text-[#002113]\" : \"text-[#7c839b]\"}`} />\n              <span>{item.label}</span>\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Footer Navigation */}\n      <div className=\"mt-auto pt-4 border-t border-white/10 space-y-1\">\n        <button className=\"w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-[#7c839b] hover:text-white hover:bg-white/5 transition-all\">\n          <Settings className=\"w-4 h-4 text-[#7c839b]\" />\n          <span>Configuraci\303\263n</span>\n        </button>\n        <button className=\"w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-sm font-medium text-[#7c839b] hover:text-white hover:bg-white/5 transition-all\">\n          <HelpCircle className=\"w-4 h-4 text-[#7c839b]\" />\n          <span>Soporte T\303\251cnico</span>\n        </button>\n      </div>\n    </nav>\n  );\n}\n"
    }
