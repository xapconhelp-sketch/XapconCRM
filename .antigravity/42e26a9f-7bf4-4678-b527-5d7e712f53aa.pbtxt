  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \"react\";\nimport { ViewType, Lead, Estimate, EstimateItem, KanbanProject, Invoice, TeamMember, CriticalAlert, InspectionAppointment, ChatMessage } from \"./types\";\nimport { \n  initialLeads, \n  initialEstimate, \n  initialProjects, \n  initialInvoices, \n  initialTeamMembers, \n  initialCriticalAlerts, \n  initialInspections \n} from \"./data\";\n\nimport Sidebar from \"./components/Sidebar\";\nimport MainDashboard from \"./components/MainDashboard\";\nimport LeadsView from \"./components/LeadsView\";\nimport EstimatorView from \"./components/EstimatorView\";\nimport ProductionView from \"./components/ProductionView\";\nimport FinancialsView from \"./components/FinancialsView\";\nimport TeamView from \"./components/TeamView\";\nimport AICopilotPanel from \"./components/AICopilotPanel\";\n\nimport { Menu, X, Bot, HelpCircle } from \"lucide-react\";\n\nexport default function App() {\n  // Views and collapsible menus\n  const [currentView, setCurrentView] = useState<ViewType>(ViewType.DASHBOARD);\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n  const [copilotOpen, setCopilotOpen] = useState(true);\n\n  // Core CRM States\n  const [leads, setLeads] = useState<Lead[]>(initialLeads);\n  const [selectedLeadId, setSelectedLeadId] = useState<string>(initialLeads[0].id);\n  const [estimate, setEstimate] = useState<Estimate>(initialEstimate);\n  const [projects, setProjects] = useState<KanbanProject[]>(initialProjects);\n  const [invoices, setInvoices] = useState<Invoice[]>(initialInvoices);\n  const [teamMembers, setTeamMembers] = useState<TeamMember[]>(initialTeamMembers);\n  const [criticalAlerts, setCriticalAlerts] = useState<CriticalAlert[]>(initialCriticalAlerts);\n  const [inspections, setInspections] = useState<InspectionAppointment[]>(initialInspections);\n\n  // Copilot Chat State\n  const [chatHistory, setChatHistory] = useState<ChatMessage[]>([]);\n  const [isLoadingCopilot, setIsLoadingCopilot] = useState(false);\n\n  // Selected Lead helper\n  const activeLead = leads.find((l) => l.id === selectedLeadId) || leads[0];\n\n  // Helper: Estimate recalculator\n  const recalculateEstimate = (items: EstimateItem[]): Estimate => {\n    let subMaterials = 0;\n    let subLabor = 0;\n    let subFees = 350; // default permits & fees pass-through\n\n    items.forEach((item) => {\n      item.total = item.qty * item.unitPrice;\n      if (item.category === \"material\") {\n        subMaterials += item.total;\n      } else if (item.category === \"labor\") {\n        subLabor += item.total;\n      } else {\n        subFees += item.total;\n      }\n    });\n\n    const subGross = subMaterials + subLabor + subFees;\n    const taxAmount = Math.round(subGross * 0.0825 * 100) / 100;\n    const total = Math.round((subGross + taxAmount) * 100) / 100;\n\n    // Calculate realistic cost based on materials and crew labor costs\n    let totalCost = 0;\n    items.forEach((item) => {\n      let costFactor = 0.6; // standard default cost factor (40% profit margin default)\n      if (item.description.includes(\"Shingle\") || item.description.includes(\"Teja\")) {\n        costFactor = 80 / 120; // shingles cost 80, sell 120 (33% margin)\n      } else if (item.description.includes(\"Underlayment\") || item.description.includes(\"Membrana\")) {\n        costFactor = 50 / 85; // underlayment cost 50, sell 85 (41% margin)\n      } else if (item.description.includes(\"Ridge\") || item.description.includes(\"Venting\")) {\n        costFactor = 8 / 12.5; // venting cost 8, sell 12.5 (36% margin)\n      } else if (item.description.includes(\"Labor\") || item.description.includes(\"Mano\")) {\n        costFactor = 60 / 95; // crew costs 60/SQ, sold at 95 (36.8% margin)\n      } else if (item.category === \"fee\") {\n        costFactor = 1.0; // fees are pass-through\n      }\n      totalCost += item.qty * (item.unitPrice * costFactor);\n    });\n\n    const profit = subGross - totalCost;\n    const profitMargin = subGross > 0 ? Math.round((profit / subGross) * 100 * 10) / 10 : 0;\n\n    return {\n      id: \"EST-2409-A\",\n      leadId: \"APX-9824\",\n      clientName: \"James Robertson\",\n      address: \"1244 Maplewood Dr, Austin, TX 78704\",\n      status: estimate.status,\n      items,\n      subtotalMaterials: subMaterials,\n      subtotalLabor: subLabor,\n      subtotalFees: subFees,\n      subtotalGross: subGross,\n      taxRate: 0.0825,\n      taxAmount,\n      total,\n      profitMargin\n    };\n  };\n\n  // Actions: Leads View\n  const handleSelectLead = (leadId: string) => {\n    setSelectedLeadId(leadId);\n    // When switching leads, update Copilot welcome context\n    const switchedLead = leads.find((l) => l.id === leadId);\n    if (switchedLead) {\n      setChatHistory([\n        {\n          sender: \"copilot\",\n          text: `He cargado el expediente de **${switchedLead.name}** (${switchedLead.id}). \302\277Qu\303\251 te gustar\303\255a revisar o calcular para su reclamo con ${switchedLead.insuranceProvider}?`,\n          timestamp: new Date().toLocaleTimeString().substring(0, 5)\n        }\n      ]);\n    }\n  };\n\n  const handleAddTimelineEvent = (leadId: string, event: Omit<TimelineEvent, \"id\" | \"timestamp\">) => {\n    setLeads((prevLeads) =>\n      prevLeads.map((l) => {\n        if (l.id === leadId) {\n          const newEvent: TimelineEvent = {\n            ...event,\n            id: `timeline-${Date.now()}`,\n            timestamp: \"Justo ahora\"\n          };\n          return {\n            ...l,\n            timeline: [newEvent, ...l.timeline]\n          };\n        }\n        return l;\n      })\n    );\n  };\n\n  const handleToggleTask = (leadId: string, taskId: string) => {\n    setLeads((prevLeads) =>\n      prevLeads.map((l) => {\n        if (l.id === leadId) {\n          return {\n            ...l,\n            tasks: l.tasks.map((t) => (t.id === taskId ? { ...t, status: t.status === \"completed\" ? \"pending\" : \"completed\" } : t))\n          };\n        }\n        return l;\n      })\n    );\n  };\n\n  const handleAddLead = (newLeadData: Omit<Lead, \"id\" | \"timeline\" | \"documents\" | \"tasks\" | \"createdAt\">) => {\n    const newLeadId = `APX-${Math.floor(1000 + Math.random() * 9000)}`;\n    const newLead: Lead = {\n      ...newLeadData,\n      id: newLeadId,\n      createdAt: \"Hoy\",\n      timeline: [\n        {\n          id: `t-${Date.now()}`,\n          type: \"system\",\n          author: \"System Event\",\n          title: \"Lead Creado\",\n          content: \"Creado manualmente en el CRM\",\n          timestamp: \"Justo ahora\"\n        }\n      ],\n      documents: [],\n      tasks: [\n        { id: `tk-${Date.now()}-1`, title: \"Calificar Lead por Tel\303\251fono\", dueDate: \"Hoy\", status: \"pending\", priority: \"high\" },\n        { id: `tk-${Date.now()}-2`, title: \"Programar Inspecci\303\263n Inicial\", dueDate: \"Ma\303\261ana\", status: \"pending\", priority: \"medium\" }\n      ],\n      aiCopilotReview: {\n        summary: `Nuevo prospecto registrado: ${newLeadData.name}. Se requiere calificar sus necesidades de techado en ${newLeadData.address}.`,\n        riskLevel: \"Bajo\",\n        riskScore: 10,\n        riskDescription: \"Prospecto nuevo sin riesgos detectados en p\303\263liza de seguro.\",\n        proactiveAlerts: [\"Se requiere contacto telef\303\263nico inicial.\"],\n        suggestions: [\"Llamar a propietario\", \"Agendar inspecci\303\263n\"]\n      }\n    };\n\n    setLeads((prev) => [newLead, ...prev]);\n    setSelectedLeadId(newLeadId);\n  };\n\n  // Actions: Claims Estimator View\n  const handleUpdateEstimateItem = (itemId: string, qty: number, unitPrice: number) => {\n    const updatedItems = estimate.items.map((item) =>\n      item.id === itemId ? { ...item, qty, unitPrice, total: qty * unitPrice } : item\n    );\n    setEstimate(recalculateEstimate(updatedItems));\n  };\n\n  const handleAddEstimateItem = (newItem: Omit<EstimateItem, \"id\" | \"total\">) => {\n    const item: EstimateItem = {\n      ...newItem,\n      id: `est-custom-${Date.now()}`,\n      total: newItem.qty * newItem.unitPrice\n    };\n    const updatedItems = [...estimate.items, item];\n    setEstimate(recalculateEstimate(updatedItems));\n  };\n\n  const handleDeleteEstimateItem = (itemId: string) => {\n    const updatedItems = estimate.items.filter((item) => item.id !== itemId);\n    setEstimate(recalculateEstimate(updatedItems));\n  };\n\n  const handleAutoAdjustMargin = () => {\n    // We target a 30% profit margin overall by adjusting the Mano de Obra (Labor) Unit Price (est-i4)\n    const laborItem = estimate.items.find((item) => item.category === \"labor\");\n    if (!laborItem) return;\n\n    let costNonLabor = 0;\n    let sellNonLabor = 0;\n\n    estimate.items.forEach((item) => {\n      if (item.category !== \"labor\") {\n        let costFactor = 0.6;\n        if (item.description.includes(\"Shingle\")) costFactor = 80 / 120;\n        else if (item.description.includes(\"Underlayment\")) costFactor = 50 / 85;\n        else if (item.description.includes(\"Ridge\") || item.description.includes(\"Venting\")) costFactor = 8 / 12.5;\n        else if (item.category === \"fee\") costFactor = 1.0;\n\n        costNonLabor += item.qty * (item.unitPrice * costFactor);\n        sellNonLabor += item.qty * item.unitPrice;\n      }\n    });\n\n    // Assume Labor Crew Cost is constant $60 per unit SQ\n    const laborCrewCost = laborItem.qty * 60;\n    const totalCost = costNonLabor + laborCrewCost;\n\n    // Target Gross Sell Price to achieve exactly 30% margin\n    // Formula: (TargetGross - totalCost) / TargetGross = 0.3 => TargetGross * 0.7 = totalCost => TargetGross = totalCost / 0.7\n    const targetGross = totalCost / 0.7;\n    const targetLaborSellTotal = targetGross - sellNonLabor;\n    const targetLaborUnitPrice = Math.round((targetLaborSellTotal / laborItem.qty) * 10) / 10;\n\n    const updatedItems = estimate.items.map((item) =>\n      item.category === \"labor\"\n        ? { ...item, unitPrice: targetLaborUnitPrice, total: item.qty * targetLaborUnitPrice }\n        : item\n    );\n\n    const adjustedEst = recalculateEstimate(updatedItems);\n    setEstimate(adjustedEst);\n\n    // Notify user in Copilot Chat\n    setChatHistory((prev) => [\n      ...prev,\n      {\n        sender: \"copilot\",\n        text: `\302\241Margen de beneficio ajustado con \303\251xito al **30.0%**! He incrementado el precio unitario de mano de obra (Labor) a **$${targetLaborUnitPrice} USD** por SQ. El subtotal bruto ahora es de **$${adjustedEst.subtotalGross.toLocaleString(\"en-US\", { minimumFractionDigits: 2 })} USD**, garantizando la rentabilidad corporativa est\303\241ndar.`,\n        timestamp: new Date().toLocaleTimeString().substring(0, 5)\n      }\n    ]);\n  };\n\n  const handleUpdateStatus = (status: \"Draft\" | \"Sent\" | \"Approved\") => {\n    setEstimate((prev) => ({ ...prev, status }));\n    if (status === \"Approved\") {\n      // Create or move projects to production pipeline\n      const exists = projects.find((p) => p.title.includes(estimate.clientName));\n      if (!exists) {\n        const newProj: KanbanProject = {\n          id: `p-auto-${Date.now()}`,\n          projectCode: `PRJ-${Math.floor(8000 + Math.random() * 99)}`,\n          title: `${estimate.clientName} Residence`,\n          address: estimate.address,\n          category: \"Architectural Shingle\",\n          durationEstimate: \"Est. 3 Days\",\n          status: \"scheduled\",\n          statusText: \"Scheduled\",\n          isWarning: false\n        };\n        setProjects((prev) => [...prev, newProj]);\n      }\n    }\n  };\n\n  // Actions: Production Kanban View\n  const handleMoveProject = (projectId: string, direction: \"next\" | \"prev\") => {\n    const stages: KanbanProject[\"status\"][] = [\"scheduled\", \"ordered\", \"in_progress\", \"qa\"];\n    setProjects((prev) =>\n      prev.map((p) => {\n        if (p.id === projectId) {\n          const currentIndex = stages.indexOf(p.status);\n          let newIndex = currentIndex;\n          if (direction === \"next\" && currentIndex < stages.length - 1) {\n            newIndex += 1;\n          } else if (direction === \"prev\" && currentIndex > 0) {\n            newIndex -= 1;\n          }\n          const nextStatus = stages[newIndex];\n          const statusTexts = {\n            scheduled: \"Scheduled\",\n            ordered: \"Material Ordered\",\n            in_progress: \"In Progress\",\n            qa: \"QA Inspection\"\n          };\n          return {\n            ...p,\n            status: nextStatus,\n            statusText: statusTexts[nextStatus],\n            progress: nextStatus === \"in_progress\" ? 10 : nextStatus === \"qa\" ? 95 : undefined\n          };\n        }\n        return p;\n      })\n    );\n  };\n\n  const handleStartQA = (project: KanbanProject) => {\n    // Move project out or mark as successfully done\n    setProjects((prev) => prev.filter((p) => p.id !== project.id));\n    // Add completed invoice to financial dashboard\n    const newInvoice: Invoice = {\n      id: `inv-auto-${Date.now()}`,\n      invoiceNumber: `INV-${Math.floor(4000 + Math.random() * 99)}`,\n      clientName: project.title.replace(\" Residence\", \"\").replace(\" Estate\", \"\"),\n      projectCategory: project.category,\n      amount: 14500,\n      status: \"Pending\"\n    };\n    setInvoices((prev) => [newInvoice, ...prev]);\n\n    // Add notification\n    setCriticalAlerts((prev) =>\n      prev.filter((a) => !a.title.includes(project.projectCode))\n    );\n  };\n\n  // Action: Dashboard Resolutions\n  const handleResolveAlert = (alert: CriticalAlert) => {\n    setCriticalAlerts((prev) => prev.filter((a) => a.id !== alert.id));\n    if (alert.targetId) {\n      if (alert.targetId.startsWith(\"APX\")) {\n        setCurrentView(ViewType.LEADS);\n        setSelectedLeadId(alert.targetId);\n      } else {\n        setCurrentView(ViewType.PRODUCTION);\n      }\n    }\n  };\n\n  // Action: Copilot Chat submit to full-stack backend\n  const handleSendCopilotMessage = async (userMsg: string) => {\n    // Append user message immediately\n    const userMessageObj: ChatMessage = {\n      sender: \"user\",\n      text: userMsg,\n      timestamp: new Date().toLocaleTimeString().substring(0, 5)\n    };\n    setChatHistory((prev) => [...prev, userMessageObj]);\n    setIsLoadingCopilot(true);\n\n    // Build context description based on current active tabs and data\n    let contextStr = `Vista actual: ${currentView.toUpperCase()}.\\n`;\n    if (currentView === ViewType.CLAIMS) {\n      contextStr += `El usuario est\303\241 revisando el presupuesto ${estimate.id} para ${estimate.clientName}.\\n`;\n      contextStr += `Monto Total: $${estimate.total.toLocaleString(\"en-US\", { minimumFractionDigits: 2 })}, Margen de Beneficio: ${estimate.profitMargin}%.\\n`;\n      contextStr += `Conceptos: ${estimate.items.map((i) => `${i.description} (Qty: ${i.qty}, Price: $${i.unitPrice})`).join(\", \")}.\\n`;\n    } else if (currentView === ViewType.LEADS) {\n      contextStr += `El usuario est\303\241 en el expediente del cliente ${activeLead.name} (${activeLead.id}).\\n`;\n      contextStr += `Direcci\303\263n: ${activeLead.address}, Seguro: ${activeLead.insuranceProvider}, Reclamo #: ${activeLead.claimNumber}.\\n`;\n      contextStr += `Estado del cliente: ${activeLead.status}.\\n`;\n    } else {\n      contextStr += `El usuario est\303\241 explorando el CRM de Apex Roofing.\\n`;\n    }\n\n    try {\n      const response = await fetch(\"/api/copilot\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          message: userMsg,\n          history: chatHistory.concat(userMessageObj),\n          context: contextStr\n        })\n      });\n      const data = await response.json();\n      \n      setChatHistory((prev) => [\n        ...prev,\n        {\n          sender: \"copilot\",\n          text: data.text,\n          timestamp: new Date().toLocaleTimeString().substring(0, 5)\n        }\n      ]);\n    } catch (err: any) {\n      console.error(\"Error communicating with AI Copilot backend:\", err);\n      setChatHistory((prev) => [\n        ...prev,\n        {\n          sender: \"copilot\",\n          text: \"Lo siento, ha ocurrido un error al conectar con el servidor del Copiloto de IA. Por favor, verifica que tu servidor Express est\303\251 encendido y que tengas tu API key configurada.\",\n          timestamp: new Date().toLocaleTimeString().substring(0, 5)\n        }\n      ]);\n    } finally {\n      setIsLoadingCopilot(false);\n    }\n  };\n\n  const handleSuggestionClick = (actionName: string) => {\n    if (actionName === \"Solicitar Reporte EagleView\") {\n      handleAddTimelineEvent(activeLead.id, {\n        type: \"system\",\n        author: \"AI Copilot\",\n        title: \"Reporte Solicitado\",\n        content: \"Se ha enviado una solicitud automatizada de reporte de medidas a EagleView para la propiedad del cliente.\"\n      });\n      setChatHistory((prev) => [\n        ...prev,\n        {\n          sender: \"copilot\",\n          text: `He solicitado oficialmente el reporte de medidas estructurales a **EagleView** para la direcci\303\263n de ${activeLead.name}. Ver\303\241s el evento registrado en la L\303\255nea de Tiempo del cliente.`,\n          timestamp: new Date().toLocaleTimeString().substring(0, 5)\n        }\n      ]);\n    } else if (actionName === \"Agendar Inspecci\303\263n F\303\255sica\") {\n      const newInsp: InspectionAppointment = {\n        id: `insp-auto-${Date.now()}`,\n        dateTime: \"Ma\303\261ana, 11:00 AM\",\n        clientName: activeLead.name,\n        address: activeLead.address,\n        type: \"Inspecci\303\263n Perito\",\n        inspectorName: \"Elena Rostova\",\n        inspectorInitials: \"ER\"\n      };\n      setInspections((prev) => [newInsp, ...prev]);\n      handleAddTimelineEvent(activeLead.id, {\n        type: \"call_log\",\n        author: \"AI Copilot\",\n        title: \"Inspecci\303\263n Perito Agendada\",\n        content: \"Se agend\303\263 inspecci\303\263n t\303\251cnica presencial en la propiedad de James Robertson para ma\303\261ana a las 11:00 AM con Elena Rostova.\"\n      });\n      setChatHistory((prev) => [\n        ...prev,\n        {\n          sender: \"copilot\",\n          text: `He agendado la inspecci\303\263n t\303\251cnica presencial para **ma\303\261ana a las 11:00 AM** con la Project Manager **Elena Rostova**. Ver\303\241s la cita a\303\261adida en el calendario del Dashboard general.`,\n          timestamp: new Date().toLocaleTimeString().substring(0, 5)\n        }\n      ]);\n    } else if (actionName === \"Enviar Recordatorio al Cliente\") {\n      handleAddTimelineEvent(activeLead.id, {\n        type: \"call_log\",\n        author: \"Michael Chen\",\n        title: \"SMS Recordatorio Enviado\",\n        content: \"Recordatorio enviado por SMS: \'Hola James, te recordamos que tu reclamo al seguro debe ingresarse pronto. Por favor ll\303\241manos.\'\"\n      });\n      setChatHistory((prev) => [\n        ...prev,\n        {\n          sender: \"copilot\",\n          text: `He disparado un SMS formal de recordatorio a **${activeLead.name}** record\303\241ndole adjuntar su n\303\272mero de p\303\263liza final. Bit\303\241cora actualizada en el expediente.`,\n          timestamp: new Date().toLocaleTimeString().substring(0, 5)\n        }\n      ]);\n    } else {\n      handleSendCopilotMessage(`Solicito ejecutar acci\303\263n: ${actionName}`);\n    }\n  };\n\n  // Quick action CTA sidebar \"Nuevo Proyecto\"\n  const handleNewEstimateCTA = () => {\n    setCurrentView(ViewType.CLAIMS);\n    setEstimate({\n      ...initialEstimate,\n      status: \"Draft\",\n      profitMargin: 24.5\n    });\n  };\n\n  // Built dynamic contextual suggestions for right side panels\n  const contextualReview = currentView === ViewType.CLAIMS \n    ? {\n        summary: `Presupuesto EST-2409-A para James Robertson. Subtotal Bruto: $${estimate.subtotalGross.toLocaleString(\"en-US\", { minimumFractionDigits: 2 })} USD. El margen actual es del ${estimate.profitMargin}%.`,\n        riskLevel: estimate.profitMargin < 30 ? \"Alto\" as const : \"Bajo\" as const,\n        riskScore: estimate.profitMargin < 30 ? 78 : 12,\n        riskDescription: estimate.profitMargin < 30 \n          ? \"El margen proyectado es inferior al umbral corporativo de seguridad del 30%. Reclamo requiere ajuste de tarifas.\"\n          : \"El margen de beneficio cumple perfectamente con los par\303\241metros de utilidad est\303\241ndar del 30%.\",\n        proactiveAlerts: estimate.profitMargin < 30 \n          ? [\"Advertencia: Mano de obra tasada por debajo del promedio est\303\241ndar.\", \"Validaci\303\263n requerida para teja asf\303\241ltica Owens Corning.\"] \n          : [],\n        suggestions: estimate.profitMargin < 30 \n          ? [\"Optimizar precio mano de obra al 30%\"] \n          : [\"Aprobar Presupuesto y Enviar\"]\n      }\n    : activeLead.aiCopilotReview;\n\n  return (\n    <div className=\"min-h-screen flex flex-col md:flex-row bg-[#f7f9fb] text-[#191c1e] font-sans antialiased overflow-hidden\">\n      \n      {/* Sidebar - Desktop */}\n      <Sidebar \n        currentView={currentView} \n        onViewChange={(view) => {\n          setCurrentView(view);\n          setMobileMenuOpen(false);\n        }}\n        onNewEstimate={handleNewEstimateCTA}\n      />\n\n      {/* Header - Mobile */}\n      <header className=\"md:hidden flex items-center justify-between px-6 py-4 bg-[#131b2e] text-white border-b border-white/15 shrink-0 select-none\">\n        <div className=\"flex items-center gap-2\">\n          <div className=\"w-8 h-8 rounded bg-[#6ffbbe] text-[#002113] flex items-center justify-center font-bold text-md\">\n            \342\226\262\n          </div>\n          <span className=\"font-sans font-bold text-[16px]\">Apex CRM</span>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <button \n            onClick={() => setCopilotOpen(!copilotOpen)}\n            className=\"p-2 text-[#6ffbbe] hover:bg-white/5 rounded-lg\"\n          >\n            <Bot className=\"w-5 h-5\" />\n          </button>\n          <button \n            onClick={() => setMobileMenuOpen(!mobileMenuOpen)}\n            className=\"p-2 text-white hover:bg-white/5 rounded-lg\"\n          >\n            {mobileMenuOpen ? <X className=\"w-5 h-5\" /> : <Menu className=\"w-5 h-5\" />}\n          </button>\n        </div>\n      </header>\n\n      {/* Mobile Drawer Navigation links */}\n      {mobileMenuOpen && (\n        <div className=\"md:hidden fixed inset-0 top-[65px] bg-[#131b2e] z-50 p-6 flex flex-col space-y-3 animate-fade-in select-none\">\n          {[\n            { id: ViewType.DASHBOARD, label: \"Dashboard\" },\n            { id: ViewType.LEADS, label: \"Leads Directory\" },\n            { id: ViewType.CLAIMS, label: \"Claims Estimator\" },\n            { id: ViewType.PRODUCTION, label: \"Production Pipeline\" },\n            { id: ViewType.FINANCIALS, label: \"Financials Overview\" },\n            { id: ViewType.TEAM, label: \"Personal & Crews\" }\n          ].map((lnk) => (\n            <button\n              key={lnk.id}\n              onClick={() => {\n                setCurrentView(lnk.id);\n                setMobileMenuOpen(false);\n              }}\n              className={`w-full text-left py-3 px-4 rounded-xl text-sm font-semibold transition-all ${\n                currentView === lnk.id ? \"bg-[#6cf8bb] text-[#002113]\" : \"text-white/70 hover:bg-white/5\"\n              }`}\n            >\n              {lnk.label}\n            </button>\n          ))}\n          <button\n            onClick={() => {\n              handleNewEstimateCTA();\n              setMobileMenuOpen(false);\n            }}\n            className=\"w-full text-center py-3 bg-[#006c49] text-white rounded-xl text-sm font-bold shadow-md\"\n          >\n            + Nuevo Proyecto\n          </button>\n        </div>\n      )}\n\n      {/* Main Container Content viewport */}\n      <main className=\"flex-1 flex flex-col xl:flex-row h-screen overflow-hidden md:ml-[280px]\">\n        \n        {/* Render View selection */}\n        {currentView === ViewType.DASHBOARD && (\n          <MainDashboard\n            kpis={[\n              { title: \"Leads del D\303\255a\", value: `${leads.length + 22}`, trend: \"+12%\", trendDirection: \"up\", subtitle: \"Prospectos calificados nuevos hoy\", icon: \"users\" },\n              { title: \"Reclamos Activos\", value: \"156\", trend: \"8 Cr\303\255ticos\", trendDirection: \"down\", subtitle: \"Reclamos ingresados a aseguradoras\", icon: \"file-text\" },\n              { title: \"Prod. en Curso\", value: `${projects.length + 38}`, trend: \"65% Completo\", trendDirection: \"up\", subtitle: \"Proyectos en proceso de techado\", icon: \"hard-hat\", progress: 65 },\n              { title: \"Pagos Pendientes\", value: `$124.5K`, trend: \"14 Facturas\", trendDirection: \"down\", subtitle: \"Facturas pendientes de cobro\", icon: \"dollar-sign\" }\n            ]}\n            alerts={criticalAlerts}\n            inspections={inspections}\n            onResolveAlert={handleResolveAlert}\n            onNavigateToView={setCurrentView}\n            onNavigateToLead={handleSelectLead}\n          />\n        )}\n\n        {currentView === ViewType.LEADS && (\n          <LeadsView\n            leads={leads}\n            selectedLeadId={selectedLeadId}\n            onSelectLead={handleSelectLead}\n            onAddTimelineEvent={handleAddTimelineEvent}\n            onToggleTask={handleToggleTask}\n            onAddLead={handleAddLead}\n          />\n        )}\n\n        {currentView === ViewType.CLAIMS && (\n          <EstimatorView\n            estimate={estimate}\n            onUpdateEstimateItem={handleUpdateEstimateItem}\n            onAddEstimateItem={handleAddEstimateItem}\n            onDeleteEstimateItem={handleDeleteEstimateItem}\n            onAutoAdjustMargin={handleAutoAdjustMargin}\n            onUpdateStatus={handleUpdateStatus}\n          />\n        )}\n\n        {currentView === ViewType.PRODUCTION && (\n          <ProductionView\n            projects={projects}\n            onMoveProject={handleMoveProject}\n            onStartQA={handleStartQA}\n          />\n        )}\n\n        {currentView === ViewType.FINANCIALS && (\n          <FinancialsView\n            invoices={invoices}\n          />\n        )}\n\n        {currentView === ViewType.TEAM && (\n          <TeamView\n            members={teamMembers}\n          />\n        )}\n\n        {/* AI Copilot side-drawer (Right hand panel) */}\n        {copilotOpen && (\n          <AICopilotPanel\n            review={contextualReview}\n            contextDescription={\n              currentView === ViewType.CLAIMS \n                ? `Estimador de James Robertson. Margen: ${estimate.profitMargin}%. Subtotal: $${estimate.subtotalGross}`\n                : `Ficha de prospecto de ${activeLead.name}. Seguro: ${activeLead.insuranceProvider}`\n            }\n            chatHistory={chatHistory}\n            onSendMessage={handleSendCopilotMessage}\n            isLoading={isLoadingCopilot}\n            onSuggestionClick={\n              currentView === ViewType.CLAIMS && estimate.profitMargin < 30\n                ? handleAutoAdjustMargin\n                : handleSuggestionClick\n            }\n          />\n        )}\n      </main>\n    </div>\n  );\n}\n"
    }
