        target_content: "import express from \"express\";\nimport path from \"path\";\nimport { createServer as createViteServer } from \"vite\";\nimport { GoogleGenAI } from \"@google/genai\";\nimport dotenv from \"dotenv\";\n\ndotenv.config();\n\nconst app = express();\nconst PORT = 3000;\n\napp.use(express.json());\n\n// Lazy-initialized Gemini client helper\nlet aiClient: GoogleGenAI | null = null;\nfunction getGeminiClient(): GoogleGenAI | null {\n  if (!aiClient) {\n    const key = process.env.GEMINI_API_KEY;\n    if (!key) {\n      console.warn(\"Warning: GEMINI_API_KEY environment variable is not defined.\");\n      return null;\n    }\n    aiClient = new GoogleGenAI({\n      apiKey: key,\n      httpOptions: {\n        headers: {\n          \'User-Agent\': \'aistudio-build\',\n        }\n      }\n    });\n  }\n  return aiClient;\n}\n\n// API endpoint for AI Copilot\napp.post(\"/api/copilot\", async (req, res) => {\n  try {\n    const { message, history, context } = req.body;\n\n    const ai = getGeminiClient();\n    if (!ai) {\n      return res.json({\n        text: \"\302\241Hola! Estoy listo para ayudarte con tu CRM de Apex Roofing. Sin embargo, no detecto una clave de API configurada en las variables de entorno. Por favor, aseg\303\272rate de configurar tu **GEMINI_API_KEY** en el panel de **Settings > Secrets** (Configuraci\303\263n > Secretos) en Google AI Studio para activar la inteligencia en tiempo real de tu Copiloto.\"\n      });\n    }\n\n    // Structure chat history and instructions\n    const systemPrompt = `Eres el \"Copiloto de IA\" de Apex Roofing CRM, un sistema premium SaaS dise\303\261ado para la gesti\303\263n de reclamaciones, estimaci\303\263n de materiales y obra, y control de tuber\303\255as de producci\303\263n de techado (roofing). \nTu tono es sumamente profesional, resolutivo, estructurado e inteligente. Respondes en espa\303\261ol.\n\nTienes acceso al siguiente contexto actual de la interfaz en la que se encuentra el usuario:\n---\n${context || \"El usuario est\303\241 navegando por el panel general de control.\"}\n---\n\nInstrucciones de comportamiento:\n1. Responde preguntas del usuario sobre reclamaciones, presupuestos de materiales, estimaciones de mano de obra o datos del cliente.\n2. Si el usuario te pide ajustar los m\303\241rgenes o hacer c\303\241lculos de techado, gu\303\255alo de forma t\303\251cnica (por ejemplo, explicando que el precio promedio por SQ de teja arquitect\303\263nica oscila entre $120 y $150 USD, y la mano de obra entre $85 y $110 USD).\n3. Ayuda a redactar correos para clientes o ajustadores de seguro de forma formal (ej. para State Farm o Allstate).\n4. S\303\251 conciso y directo en tus explicaciones. Utiliza formato markdown elegante, listas con ritmo visual y t\303\251rminos adecuados del rubro (ej. SQ para cuadrados de techado, LF para pies lineales de caballete/ridge venting, tejas asf\303\241lticas, etc.).\n5. Mant\303\251n la personalidad de un suscriptor de riesgos experto en reclamaciones de seguros por tormentas de granizo (hail damage).`;\n\n    const chatContents = [];\n    \n    // Convert history format if present\n    if (history && Array.isArray(history)) {\n      for (const msg of history) {\n        chatContents.push({\n          role: msg.sender === \"user\" ? \"user\" : \"model\",\n          parts: [{ text: msg.text }]\n        });\n      }\n    }\n    \n    // Add current user prompt\n    chatContents.push({\n      role: \"user\",\n      parts: [{ text: message }]\n    });\n\n    const response = await ai.models.generateContent({\n      model: \"gemini-3.5-flash\",\n      contents: chatContents,\n      config: {\n        systemInstruction: systemPrompt,\n        temperature: 0.7,\n      }\n    });\n\n    return res.json({ text: response.text });\n  } catch (error: any) {\n    console.error(\"Error in /api/copilot endpoint:\", error);\n    return res.status(500).json({ \n      text: \"Lo siento, ha ocurrido un error al procesar tu solicitud con el Copiloto de Inteligencia Artificial. Detalle: \" + error.message \n    });\n  }\n});\n\n// Configure Vite or serve production bundle"
