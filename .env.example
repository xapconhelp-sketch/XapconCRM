# Public browser configuration. Never place a service-role key in VITE_ variables.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# Optional: publish the actual approved documents and set their HTTPS URLs.
VITE_TERMS_URL=""
VITE_PRIVACY_URL=""

# Optional contractor map. Use a Photon-compatible HTTPS /api/ endpoint that
# permits CORS from Xapcon and is approved to receive property addresses.
VITE_VISIT_MAP_GEOCODER_URL=""
# Optional raster tile template and its required attribution.
VITE_VISIT_MAP_TILE_URL=""
VITE_VISIT_MAP_ATTRIBUTION=""

# Node production server (optional).
PORT=3001
HOST="0.0.0.0"

# Optional: WeatherAPI free key for production weather (100,000 calls/month).
# Keep this server-side; never rename it with a VITE_ prefix.
WEATHERAPI_API_KEY=""
