# Public browser configuration. Never place a service-role key in VITE_ variables.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# Optional: publish the actual approved documents and set their HTTPS URLs.
VITE_TERMS_URL=""
VITE_PRIVACY_URL=""

# Node production server (optional).
PORT=3001
HOST="0.0.0.0"

# Optional for local evaluation. Production requires an Open-Meteo commercial API key.
# Keep this server-side; never rename it with a VITE_ prefix.
OPEN_METEO_API_KEY=""
